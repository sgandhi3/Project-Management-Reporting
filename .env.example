# ─── Provider + output selection ─────────────────────────────────────────────
# Which test management tool to pull data from.
# Options: ado | jira
TEST_PROVIDER=ado

# Which output extension(s) to use — comma-separated to run multiple.
# Options: ppt, ai-summary   (add more by creating extensions/<name>.js)
OUTPUT_FORMAT=ppt

# ─── Azure DevOps (ado provider) ─────────────────────────────────────────────
# Your org name is the part after dev.azure.com/ in the URL
ADO_ORG=
ADO_PROJECT=

# Personal Access Token — needs Read access for Work Items and Test Management
# Generate one at: https://dev.azure.com/{org}/_usersSettings/tokens
ADO_PAT=

# Test plan ID — open a plan in ADO and grab the number from the URL
# A single plan is shared across workstreams; each workstream gets its own suite ID.
PLAN_ID=

# SIT suite IDs — the specific suite under each workstream that you want stats from
SIT_SUITE_PDM=
SIT_SUITE_BENEFITS=
SIT_SUITE_ENROLLMENT=
SIT_SUITE_EDI=

# Area paths for bug queries — find the exact paths in Project Settings → Area Paths
PDMAreaPath=
BenefitsAreaPath=
EnrollmentAreaPath=
EDIAreaPath=

# ─── Jira + Zephyr Scale (jira provider) ─────────────────────────────────────
# Zephyr Scale is a Jira add-on. The jira provider uses:
#   • Zephyr Scale API  — for test execution stats (cycle-based)
#   • Jira REST API     — for all other queries (bugs, tasks, etc.)
#
# Your Atlassian domain — the part before .atlassian.net in your Jira URL
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Zephyr Scale API token — generate one in Zephyr Scale → Settings → API Tokens
ZEPHYR_TOKEN=

# Jira project keys per workstream (e.g. PDM, BENEFITS)
JIRA_PROJECT_PDM=
JIRA_PROJECT_BENEFITS=
JIRA_PROJECT_ENROLLMENT=
JIRA_PROJECT_EDI=

# Zephyr test cycle keys per workstream (e.g. PDM-C1, BENEFITS-C2)
ZEPHYR_CYCLE_PDM=
ZEPHYR_CYCLE_BENEFITS=
ZEPHYR_CYCLE_ENROLLMENT=
ZEPHYR_CYCLE_EDI=

# ─── AI Summary (ai-summary extension) ───────────────────────────────────────
# Anthropic API key — generate one at console.anthropic.com
ANTHROPIC_API_KEY=

# Project notes/context file for the AI — use ONE of the two options below:

# Option A — local file (download your Excel as CSV and point here)
# SUMMARY_NOTES_FILE=./notes.csv

# Option B — URL (must be publicly accessible, returns plain text or CSV)
# SUMMARY_NOTES_URL=

# Where to save the generated summary text (default: Summary_YYYY-MM-DD.txt)
# SUMMARY_OUTPUT=./Summary.txt

# ─── PowerPoint template ─────────────────────────────────────────────────────
# Path to your template file — defaults to temp.pptx in this folder
PPTX_TEMPLATE=./temp.pptx

# ─── Debug ────────────────────────────────────────────────────────────────────
# Set to any non-empty value to print the raw queries being sent to the API.
# Useful for diagnosing missing data or 0-count results.
# DEBUG=true
