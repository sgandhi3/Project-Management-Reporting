# ─── Provider selection ────────────────────────────────────────────────────────
# Which test management tool to pull data from.
# Options: ado | jira
TEST_PROVIDER=ado

# ─── Azure DevOps credentials ─────────────────────────────────────────────────
# Only needed when TEST_PROVIDER=ado
#
# ADO_ORG    — the part after dev.azure.com/ in your browser URL
# ADO_PROJECT — your project name (case-sensitive)
# ADO_PAT    — Personal Access Token with Read access for Work Items + Test Management
#              Generate one at: https://dev.azure.com/{org}/_usersSettings/tokens
ADO_ORG=
ADO_PROJECT=
ADO_PAT=

# ─── Jira / Zephyr Scale credentials ─────────────────────────────────────────
# Only needed when TEST_PROVIDER=jira
#
# JIRA_DOMAIN     — the part before .atlassian.net in your Jira URL
# JIRA_API_TOKEN  — generate at: https://id.atlassian.com/manage-profile/security/api-tokens
# ZEPHYR_TOKEN    — Zephyr Scale API token (only needed if using Zephyr for test stats)
JIRA_DOMAIN=
JIRA_EMAIL=
JIRA_API_TOKEN=
ZEPHYR_TOKEN=

# ─── Report templates (optional — defaults shown) ─────────────────────────────
# PPTX_TEMPLATE=./temp.pptx
# EXCEL_TEMPLATE=./template.xlsx

# ─── Local weekly email (scripts/send-email-local.js) ────────────────────────
# Required only for the local Friday scheduled task, which emails the report
# as an attachment instead of relying on GitHub Actions.
#
# OUTLOOK_USER — mailbox the report is sent FROM
# OUTLOOK_PASS — an app password for that mailbox (not your normal login password)
# EMAIL_TO     — who receives it (defaults to OUTLOOK_USER if blank)
# SMTP_HOST    — defaults to smtp.office365.com; use smtp-mail.outlook.com for a
#                personal outlook.com/live.com account
OUTLOOK_USER=
OUTLOOK_PASS=
EMAIL_TO=
SMTP_HOST=

# ─── SharePoint upload (optional) ─────────────────────────────────────────────
# Only needed if you add "sharepoint" to your output formats.
# See README for Azure AD app registration steps.
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=
# SHAREPOINT_FOLDER=

# ─── Debug ────────────────────────────────────────────────────────────────────
# Uncomment to print raw API queries — useful when counts come back as 0.
# DEBUG=true

# ─────────────────────────────────────────────────────────────────────────────
# Everything else (workstreams, suite IDs, area paths, output formats,
# schedule, variable mappings) is configured in the UI or ui-config.json.
# Run:  npm run ui   →  http://localhost:3000
# ─────────────────────────────────────────────────────────────────────────────
